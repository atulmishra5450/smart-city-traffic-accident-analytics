# Smart City Traffic & Accident Analytics - .gitignore
# Rename this file to .gitignore

# Environment & secrets
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
env/
.venv/

# Data files (large CSVs)
data/raw/
data/cleaned/
data/processed/*.csv
data/processed/*.pkl

# OS
.DS_Store
Thumbs.db

# Power BI binary
*.pbix

# Streamlit secrets
.streamlit/secrets.toml
