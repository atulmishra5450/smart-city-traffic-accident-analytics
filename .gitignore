# Smart City Traffic & Accident Analytics - .gitignore

# Environment & secrets
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
env/
.venv/

# Raw and intermediate data (large files - keep out of git)
data/raw/
data/cleaned/
# NOTE: data/processed/ files ARE committed so Streamlit Cloud can use them.
# Uncomment to exclude locally:
# data/processed/*.csv
# data/processed/*.pkl

# OS
.DS_Store
Thumbs.db

# Power BI binary
*.pbix

# Streamlit secrets
.streamlit/secrets.toml